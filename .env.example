# Copy to .env and edit. Values here are read by run.py automatically.
# Real environment variables take precedence over this file.

# ---------------------------------------------------------------- required
# Public origin of this deployment. Include https:// — a bare hostname also
# works and the scheme is added for you. REQUIRED in practice for any
# deployment: it is used for manifest images and, when the stream proxy is on,
# for the URLs your player follows.
PUBLIC_URL=https://your-addon.example.com

# ---------------------------------------------------------------- streaming
# Route playback through this server. Fixes "streams are listed but don't play"
# because the player's own IP never reaches Hanime.
STREAM_PROXY_ENABLED=true

# Cached stream entries are signed HLS URLs that expire. The 6h default outlives
# them, so lower this whenever the stream proxy is on.
CACHE_TTL_STREAM=1800

# Keep proxy links valid across restarts. Any long random string.
# STREAM_PROXY_SECRET=change-me

# ---------------------------------------------------------------- general
PORT=61327
LOG_LEVEL=info

# Proxy hops to trust for client IPs. Correct behind Railway/nginx/Cloudflare
# (single hop). Set to false when the server is exposed directly.
TRUST_PROXY=1

# ---------------------------------------------------------------- optional
# Shared cache across instances. Recommended when running more than one.
# CACHE_REDIS_URL=redis://localhost:6379

# Cloudflare challenge solver. Only needed if the *handshake* endpoint starts
# returning 403. Playback via /hls/ does not require it.
# CF_BYPASS_URL=http://localhost:8742
# CF_BYPASS_TOKEN=

# Outbound proxy for the handshake/login/search calls. Useful for a genuinely
# IP-blocked endpoint, but it will NOT bypass an interactive challenge.
# HTV_PROXY_URL=http://user:pass@residential-proxy.example:8080